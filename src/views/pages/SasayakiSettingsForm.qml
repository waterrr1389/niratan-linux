//
// The app-level Sasayaki settings form inside the Settings page, following
// Features/Settings/SasayakiSettingsView.swift (body: the Enable card and its
// footer, the Settings card, the Command Center card, the Light Theme and Dark
// Theme cards) and Core/UserConfig.swift (enableSasayaki,
// readerShowSasayakiToggle, sasayakiAutoScroll, sasayakiAutoPause,
// sasayakiSkipControls and the four colours with their init defaults).
//
// Every card below Enable appears only while Enable is on, as in Swift. Each
// toggle writes through SasayakiSettingsViewModel's setter: the three reader
// booleans to the active profile's reader settings and the global keys to the
// global settings document. A colour pick renormalizes the stored hex and
// rebuilds the reader palette through ReaderViewModel, as the panel's own
// settings tab does.
//
// The instructions refer to the desktop context menu instead of a long press.
//
// The card and row chrome follows NativeMac/NativeReuseViews.swift
// (NativeSettingsSectionCard, NativeSettingsRow, NativeSettingsToggle).

pragma ComponentBehavior: Bound

import QtQuick
import Niratan

PanelScaffold {
    objectName: "settings-sasayaki"

    SasayakiSettingsViewModel {
        id: settings
    }

    // The store keeps #RRGGBBAA; Qt parses #AARRGGBB.
    component ColorRow: FormColorRow {
        required property string hex
        signal hexPicked(string hex)

        color: hex.length === 9 ? "#" + hex.slice(7) + hex.slice(1, 7) : hex
        onPicked: color => {
            const rgba = [color.r, color.g, color.b, color.a]
            hexPicked("#" + rgba.map(channel => Math.round(channel * 255).toString(16).padStart(2, "0")).join(""))
        }
    }

    FormSection {
        id: enableSection

        title: qsTr("Sasayaki")
        footer: {
            const intro = qsTr("Listen to audiobooks and read along with highlighted text.")
            if (!settings.enable)
                return intro
            return [
                intro,
                qsTr("An <b>.srt</b> file generated by <b><a href=\"%1\">SubPlz</a></b> and an audiobook (<b>.mp3</b>/<b>.m4b</b>) are required.").arg("https://github.com/kanjieater/SubPlz"),
                qsTr("Open a book’s context menu and choose Match."),
                qsTr("Choose the .srt and press Match. Matching only has to be done once."),
                qsTr("You can now open the book and choose Sasayaki from the context menu."),
                qsTr("Load the audiobook and press play, lines will be highlighted as the audiobook plays."),
                qsTr("<a href=\"%1\">More…</a>").arg("https://github.com/Manhhao/Hoshi-Reader/blob/main/SASAYAKI.md")
            ].join("<br>")
        }

        Binding {
            target: enableSection.footerLabel
            property: "textFormat"
            value: Text.StyledText
        }

        FormToggleRow {
            label: qsTr("Enable")
            checked: settings.enable
            onToggled: value => settings.enable = value
        }
    }

    FormSection {
        visible: settings.enable
        title: qsTr("Settings")

        FormToggleRow {
            label: qsTr("Show Sasayaki Toggle")
            checked: settings.showSasayakiToggle
            onToggled: value => settings.showSasayakiToggle = value
        }

        FormDivider {}
        FormToggleRow {
            label: qsTr("Auto-Scroll")
            checked: settings.autoScroll
            onToggled: value => settings.autoScroll = value
        }

        FormDivider {}
        FormToggleRow {
            label: qsTr("Auto-Pause on Lookup")
            checked: settings.autoPause
            onToggled: value => settings.autoPause = value
        }
    }

    FormSection {
        visible: settings.enable
        title: qsTr("Command Center")
        footer: qsTr("Skip Controls will replace Next/Previous Cue controls as media controls.")

        FormToggleRow {
            label: qsTr("Show Skip (\u00b115s) Controls")
            checked: settings.skipControls
            onToggled: value => settings.skipControls = value
        }
    }

    FormSection {
        visible: settings.enable
        title: qsTr("Light Theme")

        ColorRow {
            label: qsTr("Text Color")
            hex: settings.textColor
            onHexPicked: color => {
                settings.textColor = color;
                ReaderViewModel.refreshSasayakiColors();
            }
        }

        FormDivider {}
        ColorRow {
            label: qsTr("Background Color")
            hex: settings.backgroundColor
            onHexPicked: color => {
                settings.backgroundColor = color;
                ReaderViewModel.refreshSasayakiColors();
            }
        }
    }

    FormSection {
        visible: settings.enable
        title: qsTr("Dark Theme")

        ColorRow {
            label: qsTr("Text Color")
            hex: settings.darkTextColor
            onHexPicked: color => {
                settings.darkTextColor = color;
                ReaderViewModel.refreshSasayakiColors();
            }
        }

        FormDivider {}
        ColorRow {
            label: qsTr("Background Color")
            hex: settings.darkBackgroundColor
            onHexPicked: color => {
                settings.darkBackgroundColor = color;
                ReaderViewModel.refreshSasayakiColors();
            }
        }
    }
}
