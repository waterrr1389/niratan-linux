#!/bin/sh
# Tests use isolated listeners, so Niratan may stay open. The gate builds
# the working tree and only proves the commit when it matches the index.
set -e
cd "$(git rev-parse --show-toplevel)"

if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
    echo "pre-commit: unstaged or untracked changes would be checked but not committed:" >&2
    git status --short | grep -v '^[MADRC] ' >&2 || true
    echo "pre-commit: stage or stash them, then commit again." >&2
    exit 1
fi

# A commit of documentation only cannot change the build; it gets the style
# gate (banned words and tool names) instead of the full build and tests.
if [ -z "$(git diff --cached --name-only --diff-filter=ACMR | grep -v '\.md$')" ] \
    && [ -z "$(git diff --cached --name-only --diff-filter=D | grep -v '\.md$')" ]; then
    exec scripts/check-style.sh
fi

exec scripts/check.sh
