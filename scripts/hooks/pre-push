#!/bin/sh
# Runs the gate on every commit being pushed, oldest first, so each one builds
# and passes on its own and git bisect stays usable. Commits are checked out in
# a separate worktree that keeps its build directory between pushes.
set -e
zero=0000000000000000000000000000000000000000
worktree="$(git rev-parse --path-format=absolute --git-common-dir)/push-check"

commits=""
while read -r local_ref local_sha remote_ref remote_sha; do
    # A blank or short line is not a ref update. Deleting a remote ref has a
    # zero local sha and nothing to check.
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes"
    else
        range="$remote_sha..$local_sha"
    fi
    # shellcheck disable=SC2086
    commits="$commits $(git rev-list --reverse $range)"
done
[ -z "$(echo "$commits" | tr -d ' ')" ] && exit 0

if [ ! -d "$worktree" ]; then
    git worktree add --detach "$worktree" >/dev/null
fi

for commit in $commits; do
    echo "pre-push: checking $(git log -1 --format='%h %s' "$commit")" >&2
    git -C "$worktree" checkout --quiet --detach "$commit"
    git -C "$worktree" submodule update --init --quiet
    if ! "$worktree/scripts/check.sh" >"$worktree.log" 2>&1; then
        tail -n 40 "$worktree.log" >&2
        echo "pre-push: $(git log -1 --format=%h "$commit") fails the gate; full log in $worktree.log" >&2
        exit 1
    fi
done
